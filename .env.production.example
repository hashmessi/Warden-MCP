# Warden — Production Environment Template
# For MCP Server (Railway / Render)
# Copy to .env and fill in production values

# ─── PostgreSQL (Supabase) ─────────────────────────────────────────────────────
# Get from: https://supabase.com → Project → Settings → Database → URI
POSTGRES_URL=postgresql://postgres:<password>@<host>:5432/<dbname>

# ─── MongoDB (MongoDB Atlas) ──────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=warden_db

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── Optional: LLM enrichment for impact reports ─────────────────────────────
# LLM_ENABLED=true
# OPENAI_API_KEY=sk-...

# ─── Dashboard (Vercel env vars — set in Vercel project settings) ─────────────
# POSTGRES_URL=              (same as above — Vercel connects to Supabase directly)
# MONGODB_URL=               (same as above)
# MONGODB_DB=warden_db
# DASHBOARD_SECRET=          (generate: openssl rand -hex 32)
